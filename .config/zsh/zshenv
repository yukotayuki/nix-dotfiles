export DOTDIR=$HOME/dotfiles
export ZHOMEDIR=$DOTDIR/.config/zsh

# macOS 標準の ssh-agent は FIDO2 非対応のため、launchd が起動する nix openssh の ssh-agent に差し替える。
# Linux では services.ssh-agent (systemd user service) が SSH_AUTH_SOCK を設定するため上書きしない。
[[ "$OSTYPE" == "darwin"* ]] && export SSH_AUTH_SOCK="$HOME/.ssh/agent.socket"

# Rancher Desktop の CLI ツール（docker, nerdctl, helm 等）
export PATH="$HOME/.rd/bin:$PATH"

export PATH="$HOME/.tfenv/bin:$PATH"
