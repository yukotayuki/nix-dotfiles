if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}DHARMA%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful. %f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

typeset -U path fpath
[[ -d ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-completions ]] && fpath=(${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-completions $fpath)

autoload -Uz compinit && compinit -u

# kubectl completion zsh は毎回 30ms ほどかかるため、kubectl の実体が変わったときだけ作り直す。
# nix store のファイルは更新日時が 1970 年で比べられないので、実体のパスで判定する。
if (( $+commands[kubectl] )); then
    _kubectl_comp=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/kubectl-completion.zsh
    _kubectl_bin=${commands[kubectl]:A}
    [[ -s $_kubectl_comp ]] && read -r _kubectl_head < $_kubectl_comp
    if [[ "$_kubectl_head" != "# $_kubectl_bin" ]]; then
        mkdir -p ${_kubectl_comp:h}
        { print -r -- "# $_kubectl_bin"; kubectl completion zsh } >| $_kubectl_comp
    fi
    source $_kubectl_comp
    unset _kubectl_comp _kubectl_bin _kubectl_head
fi

# direnv: home-manager の programs.direnv.enable で管理するため手動 hook は不要。
# zoxide: home-manager の programs.zoxide.enable で管理するため手動 hook は不要。

bindkey -e

# source numbered config files
for config in $ZHOMEDIR/configs/[0-9]*.zsh; do
    source $config
done

# flatpak for nixos
if [[ $DISTRI == 'nixos' ]]; then
    source /run/current-system/sw/etc/profile.d/flatpak.sh
fi

# ghostty の command オプションは login シェル経由でラップされる際に引数が分割されて失敗するため、ここで起動する。
# mochi だけ tmux からの乗り換え検討のため herdr を試験導入している。
if [[ -n "$GHOSTTY_RESOURCES_DIR" && -z "$TMUX" && -z "$HERDR_ENV" ]]; then
    if [[ "$(hostname -s)" == "mochi" ]]; then
        exec herdr
    else
        exec tmux new-session -A -s main
    fi
fi

# zsh-syntax-highlighting は、後から定義した widget もハイライトの対象にするため最後に読み込む（公式の指示）。
zinit light zsh-users/zsh-syntax-highlighting
